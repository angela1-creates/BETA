{
  "name": "beta-route-reader",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:security": "node scripts/verify-supabase-security.mjs",
    "test:security:disposable": "node scripts/run-disposable-security-test.mjs",
    "test:auth-config": "node scripts/verify-auth-config.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@supabase/supabase-js": "^2.117.3",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "i18next": "^26.4.2",
    "postcss": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^17.0.16",
    "tailwindcss": "^3.4.17",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vite-plugin-pwa": "^2.0.0"
  }
}
